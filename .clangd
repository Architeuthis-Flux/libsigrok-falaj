CompileFlags:
  Compiler: clang
  Add:
    # System includes for macOS
    - "-I/usr/local/include"
    - "-I/opt/homebrew/include"
    
    # GLib includes (from pkg-config output we saw earlier)
    - "-I/opt/homebrew/Cellar/glib/2.84.3/include/glib-2.0"
    - "-I/opt/homebrew/Cellar/glib/2.84.3/lib/glib-2.0/include"
    - "-I/opt/homebrew/opt/gettext/include"
    - "-I/opt/homebrew/Cellar/pcre2/10.45/include"
    
    # libsigrok project includes - comprehensive coverage
    - "-I."
    - "-Iinclude"
    - "-Isrc"
    - "-Isrc/hardware"
    - "-Isrc/hardware/jumperless"
    - "-I/Users/kevinsanto/Documents/GitHub/libsigrok-falaj"
    - "-I/Users/kevinsanto/Documents/GitHub/libsigrok-falaj/src"
    - "-Isrc/input"
    - "-Isrc/output"
    - "-Isrc/transform"
    - "-Isrc/scale"
    - "-Isrc/lcr"
    - "-Isrc/dmm"
    - "-Isrc/bt"
    - "-Isrc/modbus"
    - "-Isrc/scpi"
    - "-Isrc/minilzo"
    
    # Additional libsigrok internal paths
    - "-Iinclude/libsigrok"
    - "-Isrc/hardware/agilent-dmm"
    - "-Isrc/hardware/appa-55ii"
    - "-Isrc/hardware/arachnid-labs-re-load-pro"
    - "-Isrc/hardware/asix-omega-rtm-cli"
    - "-Isrc/hardware/asix-sigma"
    - "-Isrc/hardware/atorch"
    - "-Isrc/hardware/atten-pps3xxx"
    - "-Isrc/hardware/baylibre-acme"
    - "-Isrc/hardware/beaglelogic"
    - "-Isrc/hardware/bkprecision-1856d"
    - "-Isrc/hardware/bp5-binmode-fala"
    - "-Isrc/hardware/cem-dt-885x"
    - "-Isrc/hardware/center-3xx"
    
    # pkg-config style includes for dependencies
    - "-I/usr/local/include/libzip"
    - "-I/usr/local/include/libusb-1.0"
    - "-I/usr/local/include/libftdi1"
    - "-I/opt/homebrew/include/libusb-1.0"
    - "-I/opt/homebrew/include/libzip"
    - "-I/opt/homebrew/Cellar/hidapi/0.15.0/include/hidapi"
    - "-I/opt/homebrew/Cellar/libftdi/1.5_2/include/libftdi1"
    
    # Standard library paths
    - "-I/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/include"
    
    # Preprocessor defines for libsigrok
    - "-DHAVE_CONFIG_H"
    - "-D_GNU_SOURCE"
    - "-DPACKAGE_VERSION=\"0.6.0\""
    - "-DLIBSIGROK_INTERNAL"
    - "-DCONF_LIBSIGROK_FIRMWAREDIR=\"/usr/local/share/sigrok-firmware\""
    
    # Driver-specific defines  
    - "-DHAVE_BP5_BINMODE_FALA"
    - "-DHAVE_JUMPERLESS_FALA"
    - "-DHAVE_JUMPERLESS_LOGIC"
    
    # Additional libsigrok feature defines
    - "-DHAVE_LIBUSB_1_0"
    - "-DHAVE_LIBSERIALPORT"
    - "-DHAVE_LIBHIDAPI"
    - "-DHAVE_LIBFTDI"
    - "-DHAVE_LIBZIP"
    - "-DHAVE_BLUETOOTH"
    
    # C standard
    - "-std=c99"
    
    # macOS specific  
    - "-mmacosx-version-min=10.15"
    
    # Common warning suppressions for C projects
    - "-Wno-unused-parameter"
    - "-Wno-unused-variable"
    - "-Wno-unused-function"
    - "-Wno-missing-field-initializers"
    - "-Wno-unused-command-line-argument"

---
Diagnostics:
  ClangTidy:
    Remove: 
      - misc-definitions-in-headers
      - readability-magic-numbers
      - cppcoreguidelines-avoid-magic-numbers
  UnusedIncludes: None 